# Local configuration for docker compose.
#   cp .env.example .env   # .env is gitignored; never commit it
# Then set DB_PASSWORD. In Kubernetes the same variables come from a Secret (External Secrets).

DB_HOST=postgres
DB_PORT=5432
DB_NAME=tasks
DB_USER=tasks
# Secret. Generate one with: openssl rand -base64 24
DB_PASSWORD=

LOG_LEVEL=INFO
# true mounts /debug/load/* (CPU and memory stress drills); keep false unless running a drill
ENABLE_DEBUG_ENDPOINTS=false
